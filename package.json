{
  "name": "video-downloader-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bunx vite build",
    "preview": "vite preview",
    "cap:sync": "bunx cap sync",
    "cap:open:android": "bunx cap open android",
    "build:android": "bun run build && bun run cap:sync && cd android && ./gradlew assembleDebug",
    "build:exe": "bun run build && electron-builder --win --config electron-builder.yml",
    "build:all": "bun run build:android && bun run build:exe"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "framer-motion": "^11.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
